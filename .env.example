# Document extraction provider. Mistral is the default and runs server-side only.
EXTRACTOR_PROVIDER=mistral
MISTRAL_API_KEY=
# A current Mistral vision model alias. Set an explicit model if you need a fixed version.
MISTRAL_MODEL=mistral-small-latest

# Optional local alternative for development.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
