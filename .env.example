# Document extraction provider. OpenRouter is the demo default and runs server-side only.
EXTRACTOR_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Select a currently available OpenRouter vision model. A :free model may have rate limits.
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# Optional alternatives for local or direct OpenAI testing.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
