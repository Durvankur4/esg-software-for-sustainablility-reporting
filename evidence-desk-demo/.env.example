# Local, free development default. Install Ollama and run: ollama pull gemma4:12b
EXTRACTOR_PROVIDER=ollama
OLLAMA_MODEL=gemma4:12b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Required only when EXTRACTOR_PROVIDER=openai. Keep this file uncommitted when populated.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# Optional. Defaults to the official Responses API endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
